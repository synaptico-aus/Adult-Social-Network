{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "store:assets": "node scripts/store-assets.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scanner:status": "tsx src/commands/scanner.ts status",
    "scanner:update": "tsx src/commands/scanner.ts update",
    "scanner:verify": "tsx src/commands/scanner.ts verify",
    "test": "tsx --test src/lib/*.test.ts src/routes/*.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@google-cloud/storage": "^7.22.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "music-metadata": "^11.16.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
